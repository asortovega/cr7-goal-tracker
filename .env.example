# Copy to .env, then replace with your API-Football key:
API_FOOTBALL_KEY=YOUR_API_FOOTBALL_KEY_HERE
PORT=3000

# Protect the API-Football free tier (100 requests/day).
# The app itself caps API usage at 90 per UTC day, with caching.
MAX_DAILY_CALLS=90

# Only change these figures after verifying an updated historical snapshot.
BASELINE_GOALS=985
BASELINE_CLUB_GOALS=9
BASELINE_2026_GOALS=28
RONALDO_PLAYER_ID=874
